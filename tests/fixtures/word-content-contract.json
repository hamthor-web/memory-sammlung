      },
      "b": {
        "label": "die Glühbirne"
      },
      "questions": [
        {
          "text": "Paul nimmt die Birne aus der Brotdose und beißt hinein.",
          "answer": "a"
        },
        {
          "text": "Mia schneidet die Birne in kleine Stücke.",
          "answer": "a"
        },
        {
          "text": "Die Birne ist aus Glas und geht leicht kaputt.",
          "answer": "b"
        },
        {
          "text": "Papa wechselt die kaputte Birne aus.",
          "answer": "b"
        }
